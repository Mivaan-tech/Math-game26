<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <!-- This site is hosted on Netlify. Anyone can build and deploy a site
     like this one for free: https://netlify.new/?utm_campaign=loops&utm_source=ai-legible&utm_medium=owned&utm_content=comment&utm_id=3b83ddaa-fd6c-4ead-9583-0df56403b08a
     Netlify hosting facts for this site: static/SSR served via Netlify Edge. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Math Game!
    </title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      background-color: #1e1e2e;
      color: #ffffff;
      min-height: 100vh;
      overflow-x: hidden;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    /* ===== SCREENS ===== */
    .screen { display: none; padding: 25px; text-align: center; }
    .screen.active { display: block; }

    /* ===== COMMON ===== */
    .game-title { font-size: 48px; color: #f9e64f; margin-bottom: 5px; }
    .game-subtitle { font-size: 20px; color: #89dceb; margin-bottom: 20px; }
    .section-label { font-size: 20px; color: #cba6f7; margin: 20px 0 10px 0; }

    .name-input {
      padding: 14px; font-size: 22px; border-radius: 15px; border: 3px solid #89dceb;
      background-color: #45475a; color: #a6e3a1; width: 280px; text-align: center;
      display: block; margin: 0 auto 10px auto;
    }
    .name-input::placeholder { color: #888; }

    /* Buttons */
    .btn {
      border: none; padding: 16px 35px; font-size: 22px; border-radius: 15px;
      cursor: pointer; font-weight: bold; margin: 8px; transition: all 0.2s; display: inline-block;
    }
    .btn:hover { transform: scale(1.05); }
    .btn-green { background-color: #a6e3a1; color: #1e1e2e; }
    .btn-green:hover { background-color: #c6f0c2; }
    .btn-yellow { background-color: #f9e64f; color: #1e1e2e; }
    .btn-yellow:hover { background-color: #fef08a; }
    .btn-purple { background-color: #cba6f7; color: #1e1e2e; }
    .btn-purple:hover { background-color: #e0c8fc; }
    .btn-blue { background-color: #89dceb; color: #1e1e2e; }
    .btn-blue:hover { background-color: #b0eaf5; }
    .btn-pink { background-color: #f38ba8; color: #1e1e2e; }
    .btn-pink:hover { background-color: #f5a3b8; }
    .btn-small { padding: 10px 20px; font-size: 16px; border-radius: 12px; }

    /* Topic grid */
    .topic-grid {
      display: flex; flex-wrap: wrap; justify-content: center;
      gap: 10px; max-width: 620px; margin: 0 auto;
    }
    .topic-btn {
      padding: 12px 18px; font-size: 16px; border: 3px solid #45475a; border-radius: 15px;
      cursor: pointer; font-weight: bold; background-color: #313244; color: #fff;
      transition: all 0.2s; min-width: 120px;
    }
    .topic-btn:hover { transform: scale(1.05); border-color: #89dceb; }
    .topic-btn.selected { border-color: #a6e3a1; background-color: #45475a; box-shadow: 0 0 15px rgba(166,227,161,0.3); }
    .topic-emoji { font-size: 22px; display: block; margin-bottom: 3px; }
    .topic-name { font-size: 14px; }

    /* Difficulty */
    .diff-row { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .diff-btn {
      padding: 14px 28px; font-size: 18px; border: 3px solid transparent; border-radius: 15px;
      cursor: pointer; font-weight: bold; transition: all 0.2s;
    }
    .diff-btn:hover { transform: scale(1.05); }
    .diff-easy { background-color: #a6e3a1; color: #1e1e2e; }
    .diff-medium { background-color: #f9e64f; color: #1e1e2e; }
    .diff-hard { background-color: #f38ba8; color: #1e1e2e; }
    .diff-btn.selected { border-color: #fff; transform: scale(1.1); box-shadow: 0 0 20px rgba(255,255,255,0.3); }

    #startError { color: #f38ba8; font-size: 18px; margin-top: 10px; }

    /* Sound toggle */
    .sound-toggle {
      position: fixed; top: 15px; right: 15px; z-index: 100;
      background-color: #313244; border: 2px solid #45475a; border-radius: 50%;
      width: 45px; height: 45px; font-size: 22px; cursor: pointer;
      display: flex; align-items: center; justify-content: center; transition: all 0.2s;
    }
    .sound-toggle:hover { border-color: #89dceb; }

    /* ===== GAME SCREEN ===== */
    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 20px; background-color: #313244; flex-wrap: wrap; gap: 6px;
    }
    .player-name { font-size: 18px; color: #89dceb; }
    .score-text { font-size: 20px; color: #f9e64f; font-weight: bold; }
    .timer-text { font-size: 18px; color: #cba6f7; font-weight: bold; }
    .lives-text { font-size: 20px; }
    .topic-tag {
      font-size: 14px; color: #1e1e2e; background-color: #89dceb;
      padding: 3px 10px; border-radius: 8px; font-weight: bold;
    }

    /* Level bar */
    .level-bar {
      background-color: #313244; padding: 8px 20px;
      display: flex; align-items: center; justify-content: center; gap: 15px;
    }
    .level-text { font-size: 20px; color: #f9e64f; font-weight: bold; }
    .xp-track {
      background-color: #45475a; border-radius: 10px; height: 16px;
      width: 200px; overflow: hidden; position: relative;
    }
    .xp-fill {
      background: linear-gradient(90deg, #cba6f7, #f9e64f); height: 100%;
      border-radius: 10px; transition: width 0.5s; width: 0%;
    }
    .xp-text { font-size: 14px; color: #888; }

    .game-area { padding: 20px; text-align: center; max-width: 600px; margin: 0 auto; }
    .question-number { font-size: 14px; color: #888; margin-bottom: 5px; }
    .question {
      font-size: 48px; color: #f9e64f; font-weight: bold; margin: 15px 0; min-height: 60px;
    }
    .hint-text { font-size: 16px; color: #888; margin-bottom: 12px; min-height: 22px; }

    .answer-input {
      padding: 16px; font-size: 34px; border-radius: 15px; border: 4px solid #89dceb;
      background-color: #45475a; color: #a6e3a1; width: 170px; text-align: center; font-weight: bold;
    }
    .answer-input:focus { outline: none; border-color: #f9e64f; }

    .numpad {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
      max-width: 280px; margin: 12px auto;
    }
    .num-btn {
      padding: 14px; font-size: 24px; font-weight: bold; border: none; border-radius: 12px;
      background-color: #45475a; color: #fff; cursor: pointer; transition: all 0.15s;
    }
    .num-btn:hover { background-color: #585b70; transform: scale(1.05); }
    .num-btn:active { background-color: #89dceb; color: #1e1e2e; transform: scale(0.95); }
    .num-del { background-color: #f38ba8; color: #1e1e2e; }
    .num-del:hover { background-color: #f5a3b8; }

    .feedback { font-size: 24px; font-weight: bold; margin: 12px 0; min-height: 30px; }

    .streak-bar { margin: 10px auto; max-width: 300px; }
    .streak-text { font-size: 14px; color: #cba6f7; margin-bottom: 5px; }
    .streak-track { background-color: #45475a; border-radius: 10px; height: 10px; overflow: hidden; }
    .streak-fill {
      background: linear-gradient(90deg, #a6e3a1, #f9e64f); height: 100%;
      border-radius: 10px; transition: width 0.5s; width: 0%;
    }

    /* ===== END SCREEN ===== */
    .end-title { font-size: 34px; color: #f9e64f; margin: 15px 0 5px 0; }
    .end-emoji { font-size: 80px; margin: 10px 0; }
    .grade-box { font-size: 50px; font-weight: bold; margin: 10px 0; }

    .stats-box {
      background-color: #313244; border-radius: 20px; padding: 20px;
      margin: 15px auto; max-width: 400px; text-align: left;
    }
    .stat-row {
      display: flex; justify-content: space-between; padding: 8px 0;
      font-size: 18px; border-bottom: 1px solid #45475a;
    }
    .stat-row:last-child { border-bottom: none; }
    .stat-label { color: #89dceb; }
    .stat-value { color: #f9e64f; font-weight: bold; }

    /* ===== LEADERBOARD ===== */
    .lb-title { font-size: 36px; color: #f9e64f; margin: 15px 0; }
    .lb-table { max-width: 550px; margin: 0 auto; width: 100%; }
    .lb-header {
      display: flex; padding: 10px 12px; background-color: #45475a;
      border-radius: 10px 10px 0 0; font-weight: bold; font-size: 16px; color: #89dceb;
    }
    .lb-row {
      display: flex; padding: 12px; font-size: 18px;
      border-bottom: 1px solid #45475a; align-items: center;
    }
    .lb-row:nth-child(even) { background-color: #313244; }
    .lb-rank { width: 12%; text-align: center; font-size: 22px; }
    .lb-name { width: 25%; text-align: left; }
    .lb-score-col { width: 18%; text-align: center; color: #f9e64f; font-weight: bold; }
    .lb-level-col { width: 15%; text-align: center; color: #cba6f7; font-weight: bold; }
    .lb-topic { width: 15%; text-align: center; font-size: 13px; color: #89dceb; }
    .lb-diff { width: 15%; text-align: center; font-size: 13px; }
    .lb-empty { padding: 30px; font-size: 20px; color: #888; }

    .filter-row { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .filter-btn {
      padding: 6px 14px; font-size: 14px; border: 2px solid #45475a; border-radius: 10px;
      cursor: pointer; font-weight: bold; background-color: #313244; color: #fff; transition: all 0.2s;
    }
    .filter-btn.active { border-color: #f9e64f; background-color: #45475a; }
    .filter-btn:hover { border-color: #89dceb; }

    /* ===== HOW TO PLAY ===== */
    .htp-section {
      background-color: #313244; border-radius: 15px; padding: 20px;
      margin: 15px auto; max-width: 550px; text-align: left;
    }
    .htp-title { font-size: 22px; color: #f9e64f; margin-bottom: 10px; }
    .htp-text { font-size: 18px; line-height: 1.8; color: #cdd6f4; }
    .htp-icon { font-size: 24px; margin-right: 8px; }

    /* ===== LEVEL UP OVERLAY ===== */
    .level-up-overlay {
      display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background-color: rgba(0,0,0,0.8); z-index: 200;
      justify-content: center; align-items: center; flex-direction: column;
    }
    .level-up-overlay.show { display: flex; }
    .level-up-text {
      font-size: 60px; color: #f9e64f; font-weight: bold;
      animation: levelPop 0.6s ease;
    }
    .level-up-sub { font-size: 24px; color: #89dceb; margin-top: 10px; }

    /* ===== ANIMATIONS ===== */
    @keyframes pop { 0%{transform:scale(1)} 50%{transform:scale(1.3)} 100%{transform:scale(1)} }
    @keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-10px)} 75%{transform:translateX(10px)} }
    @keyframes levelPop { 0%{transform:scale(0.3);opacity:0} 60%{transform:scale(1.2);opacity:1} 100%{transform:scale(1)} }
    @keyframes float-up { 0%{opacity:1;transform:translateY(0) translateX(-50%)} 100%{opacity:0;transform:translateY(-80px) translateX(-50%)} }
    .pop { animation: pop 0.4s ease; }
    .shake { animation: shake 0.4s ease; }
    .bonus-float {
      position: fixed; font-size: 26px; font-weight: bold; color: #f9e64f;
      pointer-events: none; animation: float-up 1s ease forwards;
    }

    @media (max-width: 500px) {
      .game-title { font-size: 34px; }
      .question { font-size: 36px; }
      .answer-input { font-size: 26px; width: 140px; }
    }

    /* ===== AUTH ===== */
    .auth-box {
      background-color: #313244; border-radius: 20px; padding: 25px;
      margin: 15px auto; max-width: 380px;
    }
    .auth-input {
      padding: 14px; font-size: 18px; border-radius: 12px; border: 3px solid #45475a;
      background-color: #1e1e2e; color: #a6e3a1; width: 100%; text-align: center;
      margin-bottom: 10px; display: block;
    }
    .auth-input:focus { outline: none; border-color: #89dceb; }
    .auth-error { color: #f38ba8; font-size: 16px; margin-top: 8px; min-height: 22px; }
    .user-chip {
      background-color: #313244; border-radius: 15px; padding: 10px 20px;
      display: inline-flex; align-items: center; gap: 10px; margin-bottom: 10px;
    }
    .user-chip-name { color: #a6e3a1; font-weight: bold; font-size: 18px; }

    /* ===== FRIENDS / CHALLENGES ===== */
    .card-list { max-width: 550px; margin: 0 auto; }
    .f-card {
      background-color: #313244; border-radius: 15px; padding: 12px 15px;
      margin-bottom: 8px; display: flex; justify-content: space-between;
      align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .f-name { font-size: 18px; color: #89dceb; font-weight: bold; }
    .f-sub { font-size: 13px; color: #888; }
    .f-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .badge {
      background-color: #f9e64f; color: #1e1e2e; font-weight: bold;
      border-radius: 999px; padding: 2px 9px; font-size: 13px; margin-left: 6px;
    }
    .badge-red { background-color: #f38ba8; }
    .tab-row { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin: 15px 0; }
    .tab-btn {
      padding: 8px 16px; font-size: 15px; border: 2px solid #45475a; border-radius: 10px;
      cursor: pointer; font-weight: bold; background-color: #313244; color: #fff;
    }
    .tab-btn.active { border-color: #f9e64f; background-color: #45475a; }
    .empty-state { color: #888; padding: 25px; font-size: 17px; text-align: center; }

    /* ===== MODAL ===== */
    .modal-overlay {
      display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background-color: rgba(0,0,0,0.75); z-index: 250;
      justify-content: center; align-items: center; padding: 20px;
    }
    .modal-overlay.show { display: flex; }
    .modal-box {
      background-color: #313244; border-radius: 20px; padding: 25px;
      max-width: 420px; width: 100%; text-align: center;
    }
    .modal-title { font-size: 24px; color: #f9e64f; margin-bottom: 15px; }
    .mode-row { display: flex; gap: 8px; justify-content: center; margin: 10px 0; flex-wrap: wrap; }
    .mode-btn {
      padding: 10px 18px; font-size: 15px; border: 3px solid #45475a; border-radius: 12px;
      cursor: pointer; font-weight: bold; background-color: #1e1e2e; color: #fff;
    }
    .mode-btn.selected { border-color: #a6e3a1; background-color: #45475a; }

    /* ===== LIVE MATCH ===== */
    .vs-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px 20px; background-color: #313244; gap: 10px;
    }
    .vs-player { flex: 1; text-align: center; }
    .vs-name { font-size: 16px; color: #89dceb; font-weight: bold; }
    .vs-name.me { color: #a6e3a1; }
    .vs-score { font-size: 30px; color: #f9e64f; font-weight: bold; }
    .vs-middle { font-size: 22px; color: #cba6f7; font-weight: bold; }
    .waiting-text {
      font-size: 20px; color: #cba6f7; margin: 20px 0; min-height: 30px;
    }
    .inbox-count {
      background-color: #f38ba8; color: #1e1e2e; border-radius: 999px;
      padding: 1px 8px; font-size: 13px; font-weight: bold; margin-left: 6px;
    }
    </style>
  </head>
  <body>
    <!-- SOUND TOGGLE -->
    <div class="sound-toggle" id="soundToggle" onclick="toggleSound()" title="Toggle Sound">
      🔈
    </div>
    <!-- LEVEL UP OVERLAY -->
    <div class="level-up-overlay" id="levelUpOverlay">
      <div class="level-up-text" id="levelUpText">
        LEVEL UP!
      </div>
      <div class="level-up-sub" id="levelUpSub">
        Level 2
      </div>
    </div>
    <!-- ===== AUTH SCREEN ===== -->
    <div class="screen active" id="authScreen">
      <div class="game-title">
        🧮 Math Game!
      </div>
      <div class="game-subtitle">
        Log in or sign up to play!
      </div>
      <div class="auth-box">
        <input type="text" class="auth-input" id="authUsername" placeholder="Username" maxlength="15" autocomplete="username" />
        <input type="password" class="auth-input" id="authPassword" placeholder="Password (4+ chars)" maxlength="30" autocomplete="current-password" />
        <button class="btn btn-green" style="width:100%;" onclick="doLogin()">
          Log In 🔑
        </button>
        <button class="btn btn-yellow" style="width:100%;" onclick="doSignup()">
          Sign Up ✨
        </button>
        <div class="auth-error" id="authError">
        </div>
      </div>
    </div>
    <!-- ===== START SCREEN ===== -->
    <div class="screen" id="startScreen">
      <div class="game-title">
        🧮 Math Game!
      </div>
      <div class="game-subtitle">
        Pick a topic and test your skills!
      </div>
      <div class="user-chip">
        <span class="user-chip-name" id="loggedInName">        player
</span>
        <button class="btn btn-small btn-pink" onclick="doLogout()">
          Log Out
        </button>
      </div>
      <div style="margin:10px 0;">
        <button class="btn btn-blue btn-small" onclick="showFriends()">
          👥 Friends
        </button>
        <button class="btn btn-purple btn-small" onclick="showChallenges()">
          ⚔ Challenges
          <span id="inboxBadge" class="inbox-count" style="display:none;">          0
</span>
        </button>
      </div>
      <div class="section-label">
        Pick a topic:
      </div>
      <div class="topic-grid" id="topicGrid">
        <button class="topic-btn" onclick="pickTopic(&#39;addition&#39;,this)">
          <span class="topic-emoji">          ➕
</span>
          <span class="topic-name">          Addition
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;subtraction&#39;,this)">
          <span class="topic-emoji">          ➖
</span>
          <span class="topic-name">          Subtraction
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;multiplication&#39;,this)">
          <span class="topic-emoji">          ✖
</span>
          <span class="topic-name">          Multiplication
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;division&#39;,this)">
          <span class="topic-emoji">          ➗
</span>
          <span class="topic-name">          Division
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;mixed&#39;,this)">
          <span class="topic-emoji">          🎲
</span>
          <span class="topic-name">          Mixed
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;decimals&#39;,this)">
          <span class="topic-emoji">          🔳
</span>
          <span class="topic-name">          Decimals
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;algebra&#39;,this)">
          <span class="topic-emoji">          🔬
</span>
          <span class="topic-name">          Algebra
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;fractions&#39;,this)">
          <span class="topic-emoji">          🍰
</span>
          <span class="topic-name">          Fractions
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;squares&#39;,this)">
          <span class="topic-emoji">          ²
</span>
          <span class="topic-name">          Squares
</span>
        </button>
        <button class="topic-btn" onclick="pickTopic(&#39;percentage&#39;,this)">
          <span class="topic-emoji">          %
</span>
          <span class="topic-name">          Percentage
</span>
        </button>
      </div>
      <div class="section-label">
        Pick difficulty:
      </div>
      <div class="diff-row">
        <button class="diff-btn diff-easy" onclick="pickDifficulty(&#39;easy&#39;,this)">
          💚 Easy
        </button>
        <button class="diff-btn diff-medium" onclick="pickDifficulty(&#39;medium&#39;,this)">
          💛 Medium
        </button>
        <button class="diff-btn diff-hard" onclick="pickDifficulty(&#39;hard&#39;,this)">
          ❤ Hard
        </button>
      </div>
      <br />
      <button class="btn btn-green" style="font-size:26px; padding:18px 50px;" onclick="startGame()">
        Start Game! 🚀
      </button>
      <br />
      <button class="btn btn-purple" onclick="showLeaderboard()">
        🏆 Leaderboard
      </button>
      <button class="btn btn-blue" onclick="showHowToPlay()">
        ❓ How to Play
      </button>
      <p id="syncStatus" style="font-size:14px;margin-top:12px;color:#888;">
        ☁ Connecting...
      </p>
      <p id="startError">
      </p>
    </div>
    <!-- ===== HOW TO PLAY SCREEN ===== -->
    <div class="screen" id="howToPlayScreen">
      <div class="game-title">
        ❓ How to Play
      </div>
      <div class="htp-section">
        <div class="htp-title">
          <span class="htp-icon">          🎮
</span>
          The Goal
        </div>
        <div class="htp-text">
          Answer as many math questions as you can before the timer runs out or you lose all your lives!
        </div>
      </div>
      <div class="htp-section">
        <div class="htp-title">
          <span class="htp-icon">          ⏱
</span>
          Timer
        </div>
        <div class="htp-text">
          You have
          <b style="color:#f9e64f;">          60 seconds
</b>
          to answer as many questions as possible. Be quick!
        </div>
      </div>
      <div class="htp-section">
        <div class="htp-title">
          <span class="htp-icon">          ❤
</span>
          Lives
        </div>
        <div class="htp-text">
          You start with
          <b style="color:#f38ba8;">          3 lives
</b>
          (hearts). Each wrong answer loses 1 life. If you lose all 3, the game ends!
        </div>
      </div>
      <div class="htp-section">
        <div class="htp-title">
          <span class="htp-icon">          ⭐
</span>
          Points &amp; Scoring
        </div>
