    // =====================
    // CLOUD SYNC (Automatic!)
    // =====================
    var isSyncing = false;

    function syncFromCloud() {
      if (isSyncing) return;
      isSyncing = true;
      updateSyncStatus(&#34;syncing&#34;);

      fetch(&#34;/api/sync&#34;)
        .then(function(res) { return res.json(); })
        .then(function(cloudScores) {
          if (Array.isArray(cloudScores) &amp;&amp; cloudScores.length &gt; 0) {
            var localLb = getLeaderboard();
            var merged = mergeLeaderboards(localLb, cloudScores);
            localStorage.setItem(&#34;mathGameLeaderboard&#34;, JSON.stringify(merged));
          }
          updateSyncStatus(&#34;synced&#34;);
          isSyncing = false;
        })
        .catch(function(err) {
          updateSyncStatus(&#34;error&#34;);
          isSyncing = false;
        });
    }

    function syncToCloud() {
      var lb = getLeaderboard();
      if (lb.length === 0) return;

      fetch(&#34;/api/sync&#34;, {
        method: &#34;POST&#34;,
        headers: { &#34;Content-Type&#34;: &#34;application/json&#34; },
        body: JSON.stringify({ leaderboard: lb })
      })
        .then(function(res) { return res.json(); })
        .then(function(merged) {
          if (Array.isArray(merged)) {
            localStorage.setItem(&#34;mathGameLeaderboard&#34;, JSON.stringify(merged));
          }
          updateSyncStatus(&#34;synced&#34;);
        })
        .catch(function(err) {
          updateSyncStatus(&#34;error&#34;);
        });
    }

    function updateSyncStatus(status) {
      var el = document.getElementById(&#34;syncStatus&#34;);
      if (!el) return;
      if (status === &#34;syncing&#34;) {
        el.innerHTML = &#34;&amp;#9729; Syncing...&#34;;
        el.style.color = &#34;#f9e64f&#34;;
      } else if (status === &#34;synced&#34;) {
        el.innerHTML = &#34;&amp;#9989; Synced to cloud!&#34;;
        el.style.color = &#34;#a6e3a1&#34;;
      } else if (status === &#34;error&#34;) {
        el.innerHTML = &#34;&amp;#9729; Offline mode&#34;;
        el.style.color = &#34;#888&#34;;
      }
    }

    function mergeLeaderboards(local, cloud) {
      var all = (local || []).concat(cloud || []);
      var seen = {};
      var unique = [];
      for (var i = 0; i &lt; all.length; i++) {
        var e = all[i];
        var key = e.name + &#34;|&#34; + e.score + &#34;|&#34; + e.topic + &#34;|&#34; + e.difficulty + &#34;|&#34; + e.date;
        if (!seen[key]) {
          seen[key] = true;
          unique.push(e);
        }
      }
      var diffOrder = { hard: 0, medium: 1, easy: 2 };
      unique.sort(function(a,b){
        var da = diffOrder[a.difficulty] !== undefined ? diffOrder[a.difficulty] : 3;
        var db = diffOrder[b.difficulty] !== undefined ? diffOrder[b.difficulty] : 3;
        if (da !== db) return da - db;
        return b.score - a.score;
      });
      if (unique.length &gt; 50) unique = unique.slice(0, 50);
      return unique;
    }

