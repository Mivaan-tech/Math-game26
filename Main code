    async function sendFriendRequest() {
      var err = document.getElementById(&#34;friendError&#34;);
      err.textContent = &#34;&#34;;
      var target = document.getElementById(&#34;addFriendInput&#34;).value.trim().toLowerCase();
      if (!target) { err.textContent = &#34;Enter a username.&#34;; return; }
      if (target === currentUser) { err.textContent = &#34;You can&#39;t friend yourself!&#34;; return; }
      var rec = await fbGet(&#34;/users/&#34; + target);
      if (!rec) { err.textContent = &#34;No user with that name.&#34;; return; }
      // Already friends?
      var me = await fbGet(&#34;/users/&#34; + currentUser) || {};
      if (me.friends &amp;&amp; me.friends[target]) { err.textContent = &#34;Already friends!&#34;; return; }
      await fbPut(&#34;/users/&#34; + target + &#34;/friendRequests/&#34; + currentUser, true);
      document.getElementById(&#34;addFriendInput&#34;).value = &#34;&#34;;
      err.style.color = &#34;#a6e3a1&#34;; err.textContent = &#34;Request sent!&#34;;
      setTimeout(function(){ err.textContent = &#34;&#34;; err.style.color = &#34;#f38ba8&#34;; }, 2500);
    }

