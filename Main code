    // =====================
    // LIVE MATCH
    // =====================
    var liveCtx = null;
    var livePollTimer = null;
    var liveQuestions = null;
    var liveCurrentIdx = 0;
    var liveLockAnswer = false;

    // Seeded PRNG — identical for both players
    function makeRng(seed) {
      var s = seed &gt;&gt;&gt; 0;
      return function() {
        s = (s * 1664525 + 1013904223) &gt;&gt;&gt; 0;
        return s / 0x100000000;
      };
    }
    function rngInt(rng, min, max) { return Math.floor(rng() * (max - min + 1)) + min; }

    function buildSeededQuestions(topic, difficulty, seed, count) {
      var rng = makeRng(seed);
      var qs = [];
      for (var i = 0; i &lt; count; i++) {
        qs.push(buildOneSeededQuestion(topic, difficulty, rng, i));
      }
      return qs;
    }

    function buildOneSeededQuestion(topic, difficulty, rng, idx) {
      var maxNum = difficulty === &#34;easy&#34; ? 10 : difficulty === &#34;medium&#34; ? 25 : 50;
      var mulMax = difficulty === &#34;easy&#34; ? 10 : difficulty === &#34;medium&#34; ? 12 : 15;
      var num1, num2, ans, text, hint = &#34;&#34;;
      var eff = topic;
      if (topic === &#34;mixed&#34;) {
        var ops = [&#34;addition&#34;,&#34;subtraction&#34;,&#34;multiplication&#34;,&#34;division&#34;];
        eff = ops[rngInt(rng, 0, 3)];
      }
      if (eff === &#34;addition&#34;) {
        num1 = rngInt(rng, 1, maxNum); num2 = rngInt(rng, 1, maxNum); ans = num1 + num2;
        text = num1 + &#34; + &#34; + num2 + &#34; = ?&#34;;
      } else if (eff === &#34;subtraction&#34;) {
        num1 = rngInt(rng, 1, maxNum); num2 = rngInt(rng, 1, num1); ans = num1 - num2;
        text = num1 + &#34; - &#34; + num2 + &#34; = ?&#34;;
      } else if (eff === &#34;multiplication&#34;) {
        num1 = rngInt(rng, 1, mulMax); num2 = rngInt(rng, 1, mulMax); ans = num1 * num2;
        text = num1 + &#34; \u00d7 &#34; + num2 + &#34; = ?&#34;;
      } else if (eff === &#34;division&#34;) {
        num2 = rngInt(rng, 1, mulMax); ans = rngInt(rng, 1, mulMax); num1 = num2 * ans;
        text = num1 + &#34; \u00f7 &#34; + num2 + &#34; = ?&#34;;
      } else if (topic === &#34;squares&#34;) {
        num1 = rngInt(rng, 1, difficulty === &#34;easy&#34; ? 12 : difficulty === &#34;medium&#34; ? 18 : 25);
        ans = num1 * num1;
        text = num1 + &#34;\u00b2 = ?&#34;;
        hint = num1 + &#34; \u00d7 &#34; + num1;
      } else if (topic === &#34;percentage&#34;) {
        var pcts = difficulty === &#34;easy&#34; ? [10,25,50] : difficulty === &#34;medium&#34; ? [10,20,25,50,75] : [10,20,25,30,40,50,60,75,80];
        var p = pcts[rngInt(rng, 0, pcts.length - 1)];
        num1 = rngInt(rng, 2, 10) * 20;
        ans = (p / 100) * num1;
        text = p + &#34;% of &#34; + num1 + &#34; = ?&#34;;
      } else if (topic === &#34;algebra&#34;) {
        ans = rngInt(rng, 1, maxNum);
        num2 = rngInt(rng, 1, maxNum);
        text = &#34;x + &#34; + num2 + &#34; = &#34; + (ans + num2);
        hint = &#34;Find x!&#34;;
      } else if (topic === &#34;decimals&#34;) {
        num1 = rngInt(rng, 10, 99) / 10;
        num2 = rngInt(rng, 10, 99) / 10;
        ans = parseFloat((num1 + num2).toFixed(1));
        text = num1 + &#34; + &#34; + num2 + &#34; = ?&#34;;
        hint = &#34;Answer with decimals&#34;;
      } else if (topic === &#34;fractions&#34;) {
        var denoms = [2,4]; var d = denoms[rngInt(rng,0,1)]; var n = rngInt(rng, 1, d - 1);
        var whole = rngInt(rng, 1, 5);
        ans = parseFloat((whole + n / d).toFixed(2));
        text = whole + &#34; + &#34; + n + &#34;/&#34; + d + &#34; = ?&#34;;
        hint = &#34;Answer as decimal&#34;;
      } else {
        num1 = rngInt(rng, 1, maxNum); num2 = rngInt(rng, 1, maxNum); ans = num1 + num2;
        text = num1 + &#34; + &#34; + num2 + &#34; = ?&#34;;
      }
      return { text: text, answer: ans, hint: hint };
    }

    async function enterLiveLobby(matchId, asP1) {
      liveCtx = { matchId: matchId, asP1: asP1 };
      showScreen(&#34;liveLobbyScreen&#34;);
      document.getElementById(&#34;lobbyStatus&#34;).textContent = asP1 ? &#34;Waiting for opponent to accept...&#34; : &#34;Getting ready...&#34;;
      document.getElementById(&#34;lobbyInfo&#34;).innerHTML = &#34;&#34;;
      pollLobby();
    }

    async function pollLobby() {
      stopLivePoll();
      livePollTimer = setInterval(async function() {
        if (!liveCtx) return;
        var m = await fbGet(&#34;/liveMatches/&#34; + liveCtx.matchId);
        if (!m) { stopLivePoll(); alert(&#34;Match cancelled.&#34;); goToStart(); return; }
        var info = document.getElementById(&#34;lobbyInfo&#34;);
        info.innerHTML =
          &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;You&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39; + (liveCtx.asP1 ? m.players.p1 : m.players.p2) + &#39;&lt;/span&gt;&lt;/div&gt;&#39; +
          &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;Opponent&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39; + (liveCtx.asP1 ? m.players.p2 : m.players.p1) + &#39;&lt;/span&gt;&lt;/div&gt;&#39; +
          &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;Topic&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39; + topicLabel(m.topic) + &#39;&lt;/span&gt;&lt;/div&gt;&#39; +
          &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;Difficulty&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39; + m.difficulty.toUpperCase() + &#39;&lt;/span&gt;&lt;/div&gt;&#39;;
        if (m.ready &amp;&amp; m.ready.p1 &amp;&amp; m.ready.p2 &amp;&amp; m.status === &#34;waiting&#34;) {
          await fbPatch(&#34;/liveMatches/&#34; + liveCtx.matchId, { status: &#34;playing&#34;, startedAt: Date.now() });
        }
        if (m.status === &#34;playing&#34;) {
          stopLivePoll();
          startLiveMatch(m);
        } else if (m.status === &#34;done&#34;) {
          stopLivePoll();
          finishLiveMatch(m);
        }
      }, 800);
    }

    function stopLivePoll() { if (livePollTimer) { clearInterval(livePollTimer); livePollTimer = null; } }

    function startLiveMatch(m) {
      liveQuestions = buildSeededQuestions(m.topic, m.difficulty, m.seed, 10);
      liveCurrentIdx = m.currentQ || 0;
      liveLockAnswer = false;
      var meName = liveCtx.asP1 ? m.players.p1 : m.players.p2;
      var oppName = liveCtx.asP1 ? m.players.p2 : m.players.p1;
      document.getElementById(&#34;liveMeName&#34;).textContent = meName + &#34; (you)&#34;;
      document.getElementById(&#34;liveOppName&#34;).textContent = oppName;
      document.getElementById(&#34;liveMeScore&#34;).textContent = liveCtx.asP1 ? (m.scores.p1 || 0) : (m.scores.p2 || 0);
      document.getElementById(&#34;liveOppScore&#34;).textContent = liveCtx.asP1 ? (m.scores.p2 || 0) : (m.scores.p1 || 0);
      document.getElementById(&#34;liveFeedback&#34;).textContent = &#34;&#34;;
      document.getElementById(&#34;liveAnswerInput&#34;).value = &#34;&#34;;
      showLiveQuestion();
      showScreen(&#34;liveMatchScreen&#34;);
      startLivePlayPoll();
    }

    function showLiveQuestion() {
      if (liveCurrentIdx &gt;= 10) return;
      var q = liveQuestions[liveCurrentIdx];
      document.getElementById(&#34;liveQuestion&#34;).textContent = q.text;
      document.getElementById(&#34;liveHint&#34;).textContent = q.hint || &#34;&#34;;
      document.getElementById(&#34;liveRound&#34;).textContent = (liveCurrentIdx + 1) + &#34; / 10&#34;;
      document.getElementById(&#34;liveAnswerInput&#34;).value = &#34;&#34;;
      document.getElementById(&#34;liveFeedback&#34;).textContent = &#34;&#34;;
      liveLockAnswer = false;
    }

    function liveTapNum(n) { var i = document.getElementById(&#34;liveAnswerInput&#34;); i.value += n; soundClick(); }
    function liveTapDel() { var i = document.getElementById(&#34;liveAnswerInput&#34;); i.value = i.value.slice(0, -1); soundClick(); }

    async function checkLiveAnswer() {
      if (liveLockAnswer) return;
      if (!liveCtx || !liveQuestions) return;
      var guess = document.getElementById(&#34;liveAnswerInput&#34;).value.trim();
      if (guess === &#34;&#34;) return;
      var q = liveQuestions[liveCurrentIdx];
      var correct = parseFloat(guess) === q.answer;
      if (!correct) {
        document.getElementById(&#34;liveFeedback&#34;).innerHTML = &#34;&amp;#128533; Nope — keep trying!&#34;;
        document.getElementById(&#34;liveFeedback&#34;).style.color = &#34;#f38ba8&#34;;
        document.getElementById(&#34;liveAnswerInput&#34;).value = &#34;&#34;;
        soundWrong();
        return;
      }
      liveLockAnswer = true;
      var claimPath = &#34;/liveMatches/&#34; + liveCtx.matchId + &#34;/questionWinners/q&#34; + liveCurrentIdx;
      var current = await fbGet(claimPath);
      if (current) {
        document.getElementById(&#34;liveFeedback&#34;).innerHTML = &#34;&amp;#9201; Too slow! &#34; + current + &#34; got it!&#34;;
        document.getElementById(&#34;liveFeedback&#34;).style.color = &#34;#f9e64f&#34;;
        soundSkip();
        return;
      }
      await fbPut(claimPath, currentUser);
      // Re-read to see who actually got last-write
      var actualWinner = await fbGet(claimPath);
      if (actualWinner === currentUser) {
        document.getElementById(&#34;liveFeedback&#34;).innerHTML = &#34;&amp;#127881; You got it!&#34;;
        document.getElementById(&#34;liveFeedback&#34;).style.color = &#34;#a6e3a1&#34;;
        soundCorrect();
      } else {
        document.getElementById(&#34;liveFeedback&#34;).innerHTML = &#34;&amp;#9201; Too slow! &#34; + actualWinner + &#34; got it!&#34;;
        document.getElementById(&#34;liveFeedback&#34;).style.color = &#34;#f9e64f&#34;;
        soundSkip();
      }
      await fbPatch(&#34;/liveMatches/&#34; + liveCtx.matchId, { currentQ: liveCurrentIdx + 1 });
    }

    function computeScoresFromWinners(m) {
      var winners = m.questionWinners || {};
      var p1n = m.players.p1, p2n = m.players.p2;
      var s1 = 0, s2 = 0;
      for (var k in winners) {
        if (winners[k] === p1n) s1++;
        else if (winners[k] === p2n) s2++;
      }
      return { p1: s1, p2: s2 };
    }

    function startLivePlayPoll() {
      stopLivePoll();
      livePollTimer = setInterval(async function() {
        if (!liveCtx) { stopLivePoll(); return; }
        var m = await fbGet(&#34;/liveMatches/&#34; + liveCtx.matchId);
        if (!m) { stopLivePoll(); return; }
        var sc = computeScoresFromWinners(m);
        document.getElementById(&#34;liveMeScore&#34;).textContent = liveCtx.asP1 ? sc.p1 : sc.p2;
        document.getElementById(&#34;liveOppScore&#34;).textContent = liveCtx.asP1 ? sc.p2 : sc.p1;
        // Advance question when claim appears for current question
        var winner = (m.questionWinners || {})[&#34;q&#34; + liveCurrentIdx];
        if (winner) {
          if (winner !== currentUser &amp;&amp; !liveLockAnswer) {
            document.getElementById(&#34;liveFeedback&#34;).innerHTML = &#34;&amp;#9201; &#34; + winner + &#34; got it first!&#34;;
            document.getElementById(&#34;liveFeedback&#34;).style.color = &#34;#f9e64f&#34;;
            liveLockAnswer = true;
            soundSkip();
          }
          setTimeout(function() {
            liveCurrentIdx = liveCurrentIdx + 1;
            if (liveCurrentIdx &gt;= 10) {
              fbPatch(&#34;/liveMatches/&#34; + liveCtx.matchId, { status: &#34;done&#34; });
            } else if (m.status !== &#34;done&#34;) {
              showLiveQuestion();
            }
          }, 1300);
          // Prevent repeated advance: bump local idx optimistically after scheduling
          liveLockAnswer = true;
        }
        if (m.status === &#34;done&#34;) {
          stopLivePoll();
          finishLiveMatch(m);
        }
      }, 700);
    }

    async function finishLiveMatch(m) {
      stopLivePoll();
      var meKey = liveCtx.asP1 ? &#34;p1&#34; : &#34;p2&#34;;
      var oppKey = liveCtx.asP1 ? &#34;p2&#34; : &#34;p1&#34;;
      var meScore = m.scores[meKey] || 0;
      var oppScore = m.scores[oppKey] || 0;
      var oppName = m.players[oppKey];
      var winner = meScore === oppScore ? &#34;tie&#34; : (meScore &gt; oppScore ? currentUser : oppName);
      // Save result summary for me
      var resultId = m.id;
      var summary = { opponent: oppName, topic: m.topic, difficulty: m.difficulty,
        myScore: meScore, theirScore: oppScore, winner: winner, when: Date.now(), live: true };
      await fbPut(&#34;/users/&#34; + currentUser + &#34;/challengeResults/&#34; + resultId, summary);

      // Show end screen with result
      showScreen(&#34;endScreen&#34;);
      var title = winner === &#34;tie&#34; ? &#34;It&#39;s a Tie!&#34; : (winner === currentUser ? &#34;YOU WIN!&#34; : oppName + &#34; Wins&#34;);
      var emoji = winner === currentUser ? &#34;&amp;#127942;&#34; : winner === &#34;tie&#34; ? &#34;&amp;#129309;&#34; : &#34;&amp;#128531;&#34;;
      document.getElementById(&#34;endEmoji&#34;).innerHTML = emoji;
      document.getElementById(&#34;endTitle&#34;).textContent = title;
      document.getElementById(&#34;gradeBox&#34;).innerHTML =
        &#39;&lt;span style=&#34;color:#a6e3a1;font-size:50px;&#34;&gt;&#39; + meScore + &#39;&lt;/span&gt;&#39; +
        &#39;&lt;span style=&#34;color:#888;font-size:30px;&#34;&gt; vs &lt;/span&gt;&#39; +
        &#39;&lt;span style=&#34;color:#f38ba8;font-size:50px;&#34;&gt;&#39; + oppScore + &#39;&lt;/span&gt;&#39;;
      document.getElementById(&#34;statsBox&#34;).innerHTML =
        &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;&amp;#9889; Mode&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;Live Race&lt;/span&gt;&lt;/div&gt;&#39; +
        &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;&amp;#128100; Opponent&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39; + oppName + &#39;&lt;/span&gt;&lt;/div&gt;&#39; +
        &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;&amp;#128218; Topic&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39; + topicLabel(m.topic) + &#39;&lt;/span&gt;&lt;/div&gt;&#39; +
        &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;&amp;#127942; Difficulty&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39; + m.difficulty.toUpperCase() + &#39;&lt;/span&gt;&lt;/div&gt;&#39;;
      soundGameOver();
      liveCtx = null; liveQuestions = null;
    }

    async function cancelLiveMatch() {
      if (liveCtx) {
        await fbPatch(&#34;/liveMatches/&#34; + liveCtx.matchId, { status: &#34;done&#34; });
        liveCtx = null;
      }
      stopLivePoll();
      goToStart();
    }

    // Enter keys
    document.getElementById(&#34;answerInput&#34;).addEventListener(&#34;keydown&#34;, function(e) { if (e.key === &#34;Enter&#34;) checkAnswer(); });
    document.getElementById(&#34;authPassword&#34;).addEventListener(&#34;keydown&#34;, function(e) { if (e.key === &#34;Enter&#34;) doLogin(); });
    document.getElementById(&#34;liveAnswerInput&#34;).addEventListener(&#34;keydown&#34;, function(e) { if (e.key === &#34;Enter&#34;) checkLiveAnswer(); });

    // Make sure correct screen shows when page loads
    window.onload = async function() {
      var restored = await tryRestoreSession();
      if (restored) { enterApp(); }
      else { showScreen(&#34;authScreen&#34;); }
      syncFromCloud();

      // Register service worker for offline play
      if (&#34;serviceWorker&#34; in navigator) {
        navigator.serviceWorker.register(&#34;/sw.js&#34;).catch(function(){});
      }
    };
    </script>
  </body>
</html>
