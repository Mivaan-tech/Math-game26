    // =====================
    // LEADERBOARD
    // =====================
    function getLeaderboard() {
      var d = localStorage.getItem(&#34;mathGameLeaderboard&#34;);
      return d ? JSON.parse(d) : [];
    }

    function saveToLeaderboard(name, sc, tp, df, pct, lvl) {
      var lb = getLeaderboard();
      lb.push({ name:name, score:sc, topic:tp, difficulty:df, percent:pct, level:lvl, date:new Date().toLocaleDateString() });
      var diffOrder = { hard: 0, medium: 1, easy: 2 };
      lb.sort(function(a,b){
        var da = diffOrder[a.difficulty] !== undefined ? diffOrder[a.difficulty] : 3;
        var db = diffOrder[b.difficulty] !== undefined ? diffOrder[b.difficulty] : 3;
        if (da !== db) return da - db;
        return b.score - a.score;
      });
      if (lb.length &gt; 50) lb = lb.slice(0, 50);
      localStorage.setItem(&#34;mathGameLeaderboard&#34;, JSON.stringify(lb));
      syncToCloud();
    }

    function showLeaderboard() {
      soundClick();
      showScreen(&#34;leaderboardScreen&#34;);
      syncFromCloud();
      renderLeaderboard();
    }

    function clearAllScores() {
      // Check if locked out
      var lockUntil = localStorage.getItem(&#34;clearLockUntil&#34;);
      if (lockUntil &amp;&amp; Date.now() &lt; Number(lockUntil)) {
        var hoursLeft = Math.ceil((Number(lockUntil) - Date.now()) / 3600000);
        alert(&#34;Too many wrong attempts! Locked for &#34; + hoursLeft + &#34; more hour&#34; + (hoursLeft === 1 ? &#34;&#34; : &#34;s&#34;) + &#34;.&#34;);
        return;
      }
      // Reset attempts if lock expired
      if (lockUntil &amp;&amp; Date.now() &gt;= Number(lockUntil)) {
        localStorage.removeItem(&#34;clearAttempts&#34;);
        localStorage.removeItem(&#34;clearLockUntil&#34;);
      }

      var attempts = Number(localStorage.getItem(&#34;clearAttempts&#34;) || 0);
      var attemptsLeft = 5 - attempts;

      var code = prompt(&#34;Enter password to erase all scores (&#34; + attemptsLeft + &#34; attempt&#34; + (attemptsLeft === 1 ? &#34;&#34; : &#34;s&#34;) + &#34; left):&#34;);
      if (!code) return;

      if (code.toLowerCase() !== &#34;riyansh&#34;) {
        attempts++;
        localStorage.setItem(&#34;clearAttempts&#34;, attempts);
        if (attempts &gt;= 5) {
          localStorage.setItem(&#34;clearLockUntil&#34;, Date.now() + 86400000);
          alert(&#34;Wrong password! Locked for 24 hours.&#34;);
        } else {
          alert(&#34;Wrong password! &#34; + (5 - attempts) + &#34; attempt&#34; + (5 - attempts === 1 ? &#34;&#34; : &#34;s&#34;) + &#34; left.&#34;);
        }
        return;
      }

      // Correct password - reset attempts and clear scores
      localStorage.removeItem(&#34;clearAttempts&#34;);
      localStorage.removeItem(&#34;clearLockUntil&#34;);
      localStorage.setItem(&#34;mathGameLeaderboard&#34;, JSON.stringify([]));
      fetch(&#34;/api/sync&#34;, {
        method: &#34;POST&#34;,
        headers: { &#34;Content-Type&#34;: &#34;application/json&#34; },
        body: JSON.stringify({ leaderboard: [] })
      }).catch(function(){});
      renderLeaderboard();
      soundClick();
    }

    function renderLeaderboard() {
      var lb = getLeaderboard();
      var body = document.getElementById(&#34;lbBody&#34;);
      body.innerHTML = &#34;&#34;;

      var filtered = lbFilter === &#34;all&#34; ? lb : lb.filter(function(e){ return e.topic === lbFilter; });

      if (filtered.length === 0) {
        body.innerHTML = &#39;&lt;div class=&#34;lb-empty&#34;&gt;No scores yet! Play a game! &amp;#127918;&lt;/div&gt;&#39;;
        return;
      }

      var medals = [&#34;&amp;#129351;&#34;,&#34;&amp;#129352;&#34;,&#34;&amp;#129353;&#34;];
      var tn = {addition:&#34;Add&#34;,subtraction:&#34;Sub&#34;,multiplication:&#34;Mul&#34;,division:&#34;Div&#34;,mixed:&#34;Mix&#34;,
        decimals:&#34;Dec&#34;,algebra:&#34;Alg&#34;,fractions:&#34;Frac&#34;,squares:&#34;Sq&#34;,percentage:&#34;Pct&#34;};

      // Group by difficulty
      var groups = [&#34;hard&#34;, &#34;medium&#34;, &#34;easy&#34;];
      var groupLabels = { hard: &#34;&amp;#10084; HARD&#34;, medium: &#34;&amp;#128155; MEDIUM&#34;, easy: &#34;&amp;#128154; EASY&#34; };
      var groupColors = { hard: &#34;#f38ba8&#34;, medium: &#34;#f9e64f&#34;, easy: &#34;#a6e3a1&#34; };

      for (var g = 0; g &lt; groups.length; g++) {
        var diff = groups[g];
        var entries = filtered.filter(function(e) { return e.difficulty === diff; });
        // Sort by score within group
        entries.sort(function(a, b) { return b.score - a.score; });

        if (entries.length === 0) continue;

        // Group header
        var header = document.createElement(&#34;div&#34;);
        header.style.cssText = &#34;padding:10px 15px;font-size:18px;font-weight:bold;color:&#34; + groupColors[diff] + &#34;;background-color:#1e1e2e;border-bottom:2px solid &#34; + groupColors[diff] + &#34;;&#34;;
        header.innerHTML = groupLabels[diff];
        body.appendChild(header);

        // Entries (max 10 per group)
        for (var i = 0; i &lt; Math.min(entries.length, 10); i++) {
          var e = entries[i];
          var rank = i &lt; 3 ? medals[i] : (i + 1);

          var row = document.createElement(&#34;div&#34;);
          row.className = &#34;lb-row&#34;;
          row.innerHTML =
            &#39;&lt;div class=&#34;lb-rank&#34;&gt;&#39;+rank+&#39;&lt;/div&gt;&#39; +
            &#39;&lt;div class=&#34;lb-name&#34;&gt;&#39;+e.name+&#39;&lt;/div&gt;&#39; +
            &#39;&lt;div class=&#34;lb-score-col&#34;&gt;&#39;+e.score+&#39;&lt;/div&gt;&#39; +
            &#39;&lt;div class=&#34;lb-level-col&#34;&gt;Lv.&#39;+(e.level || 1)+&#39;&lt;/div&gt;&#39; +
            &#39;&lt;div class=&#34;lb-topic&#34;&gt;&#39;+(tn[e.topic]||e.topic)+&#39;&lt;/div&gt;&#39; +
            &#39;&lt;div class=&#34;lb-diff&#34; style=&#34;color:&#39;+groupColors[diff]+&#39;;&#34;&gt;&#39;+e.difficulty.toUpperCase()+&#39;&lt;/div&gt;&#39;;
          body.appendChild(row);
        }
      }
    }

    function filterLB(f, btn) {
      lbFilter = f; soundClick();
      var btns = document.querySelectorAll(&#34;.filter-btn&#34;);
      for (var i = 0; i &lt; btns.length; i++) btns[i].classList.remove(&#34;active&#34;);
