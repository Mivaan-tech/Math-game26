    // =====================
    // START GAME
    // =====================
    function startGame() {
      if (!currentUser) { showScreen(&#34;authScreen&#34;); return; }
      playerName = currentUser;
      if (!topic) { document.getElementById(&#34;startError&#34;).textContent = &#34;Pick a topic first!&#34;; return; }
      if (!difficulty) { document.getElementById(&#34;startError&#34;).textContent = &#34;Pick a difficulty first!&#34;; return; }
      document.getElementById(&#34;startError&#34;).textContent = &#34;&#34;;

      score = 0; lives = 3; questionCount = 0; correctCount = 0; wrongCount = 0;
      skippedCount = 0; streak = 0; bestStreak = 0; timeLeft = 60;
      level = 1; xp = 0; xpForNext = getXpNeeded(1);

      var topicNames = {
        addition:&#34;Addition&#34;, subtraction:&#34;Subtraction&#34;, multiplication:&#34;Multiplication&#34;,
        division:&#34;Division&#34;, mixed:&#34;Mixed&#34;, decimals:&#34;Decimals&#34;,
        algebra:&#34;Algebra&#34;, fractions:&#34;Fractions&#34;, squares:&#34;Squares&#34;, percentage:&#34;Percentage&#34;
      };

      document.getElementById(&#34;displayName&#34;).innerHTML = &#34;&amp;#127918; &#34; + playerName;
      document.getElementById(&#34;topicTag&#34;).textContent = topicNames[topic] || topic;
      document.getElementById(&#34;timerDisplay&#34;).style.color = &#34;#cba6f7&#34;;
      updateScore(); updateLives(); updateStreak(); updateLevel();
      showScreen(&#34;gameScreen&#34;);
      soundStart();
      newQuestion();
      startTimer();
    }

    // =====================
    // TIMER
    // =====================
    function startTimer() {
      clearInterval(timer);
      timer = setInterval(function () {
        timeLeft--;
        document.getElementById(&#34;timerDisplay&#34;).innerHTML = &#34;&amp;#9201; &#34; + timeLeft + &#34;s&#34;;
        if (timeLeft &lt;= 10) {
          document.getElementById(&#34;timerDisplay&#34;).style.color = &#34;#f38ba8&#34;;
          soundTick();
        }
        if (timeLeft &lt;= 0) endGame();
      }, 1000);
    }

    // =====================
    // HELPERS
    // =====================
    function randomNumber(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
    function randomDecimal(min, max, places) { return parseFloat((Math.random() * (max - min) + min).toFixed(places)); }
    function gcd(a, b) { a = Math.abs(a); b = Math.abs(b); while (b) { var t = b; b = a % b; a = t; } return a; }

    // =====================
    // LEVEL SCALING
    // =====================
    function getLevelMaxNum() {
      var base = difficulty === &#34;easy&#34; ? 10 : difficulty === &#34;medium&#34; ? 25 : 50;
      // Each level adds bigger numbers
      return base + (level - 1) * 10;
    }

    function getLevelMulMax() {
      var base = difficulty === &#34;easy&#34; ? 10 : difficulty === &#34;medium&#34; ? 12 : 15;
      return Math.min(base + (level - 1) * 3, 30);
    }

    // =====================
    // NEW QUESTION
    // =====================
    function newQuestion() {
      waiting = false;
      questionCount++;
      document.getElementById(&#34;questionNum&#34;).textContent = &#34;Question &#34; + questionCount;
      document.getElementById(&#34;answerInput&#34;).value = &#34;&#34;;
      document.getElementById(&#34;feedback&#34;).textContent = &#34;&#34;;
      document.getElementById(&#34;hintText&#34;).textContent = &#34;&#34;;
      document.getElementById(&#34;answerInput&#34;).focus();
      document.getElementById(&#34;answerInput&#34;).type = &#34;text&#34;;

      var num1, num2, questionText, hint = &#34;&#34;;
      var maxNum = getLevelMaxNum();
      var mulMax = getLevelMulMax();

      if (topic === &#34;addition&#34;) {
        num1 = randomNumber(1, maxNum); num2 = randomNumber(1, maxNum);
        currentAnswer = num1 + num2; currentAnswerStr = String(currentAnswer);
        questionText = num1 + &#34; + &#34; + num2 + &#34; = ?&#34;;

      } else if (topic === &#34;subtraction&#34;) {
        num1 = randomNumber(1, maxNum); num2 = randomNumber(1, num1);
        currentAnswer = num1 - num2; currentAnswerStr = String(currentAnswer);
        questionText = num1 + &#34; - &#34; + num2 + &#34; = ?&#34;;

      } else if (topic === &#34;multiplication&#34;) {
        num1 = randomNumber(1, mulMax); num2 = randomNumber(1, mulMax);
        currentAnswer = num1 * num2; currentAnswerStr = String(currentAnswer);
        questionText = num1 + &#34; \u00d7 &#34; + num2 + &#34; = ?&#34;;

      } else if (topic === &#34;division&#34;) {
        num2 = randomNumber(1, mulMax); currentAnswer = randomNumber(1, mulMax);
        num1 = num2 * currentAnswer; currentAnswerStr = String(currentAnswer);
        questionText = num1 + &#34; \u00f7 &#34; + num2 + &#34; = ?&#34;;

      } else if (topic === &#34;mixed&#34;) {
        var ops = [&#34;+&#34;,&#34;-&#34;,&#34;\u00d7&#34;,&#34;\u00f7&#34;];
        var op = ops[randomNumber(0,3)];
        if (op===&#34;+&#34;) { num1=randomNumber(1,maxNum); num2=randomNumber(1,maxNum); currentAnswer=num1+num2; }
        else if (op===&#34;-&#34;) { num1=randomNumber(1,maxNum); num2=randomNumber(1,num1); currentAnswer=num1-num2; }
        else if (op===&#34;\u00d7&#34;) { num1=randomNumber(1,mulMax); num2=randomNumber(1,mulMax); currentAnswer=num1*num2; }
        else { num2=randomNumber(1,12); currentAnswer=randomNumber(1,12); num1=num2*currentAnswer; }
        currentAnswerStr = String(currentAnswer);
        questionText = num1 + &#34; &#34; + op + &#34; &#34; + num2 + &#34; = ?&#34;;

      } else if (topic === &#34;decimals&#34;) {
        var places = difficulty === &#34;easy&#34; ? 1 : difficulty === &#34;medium&#34; ? 1 : 2;
        var dMax = difficulty === &#34;easy&#34; ? 10 + level * 5 : difficulty === &#34;medium&#34; ? 20 + level * 8 : 50 + level * 10;
        var dOps = difficulty === &#34;easy&#34; ? [&#34;+&#34;,&#34;-&#34;] : [&#34;+&#34;,&#34;-&#34;,&#34;\u00d7&#34;];
        var dOp = dOps[randomNumber(0, dOps.length - 1)];
        if (dOp === &#34;+&#34;) {
          num1 = randomDecimal(1, dMax, places); num2 = randomDecimal(1, dMax, places);
          currentAnswer = parseFloat((num1 + num2).toFixed(places));
          questionText = num1 + &#34; + &#34; + num2 + &#34; = ?&#34;;
        } else if (dOp === &#34;-&#34;) {
          num1 = randomDecimal(2, dMax, places); num2 = randomDecimal(1, num1, places);
          currentAnswer = parseFloat((num1 - num2).toFixed(places));
          questionText = num1 + &#34; - &#34; + num2 + &#34; = ?&#34;;
        } else {
          num1 = randomDecimal(1, 10, 1); num2 = randomNumber(1, 9);
          currentAnswer = parseFloat((num1 * num2).toFixed(1));
          questionText = num1 + &#34; \u00d7 &#34; + num2 + &#34; = ?&#34;;
        }
        currentAnswerStr = String(currentAnswer);
        hint = &#34;Answer with decimals (e.g. 3.5)&#34;;

      } else if (topic === &#34;algebra&#34;) {
        var aMax = maxNum;
        var aOps = difficulty === &#34;easy&#34; ? [&#34;+&#34;,&#34;-&#34;] : [&#34;+&#34;,&#34;-&#34;,&#34;\u00d7&#34;];
        var aOp = aOps[randomNumber(0, aOps.length - 1)];
        currentAnswer = randomNumber(1, aMax);
        if (aOp === &#34;+&#34;) {
          num2 = randomNumber(1, aMax); var r = currentAnswer + num2;
          questionText = &#34;x + &#34; + num2 + &#34; = &#34; + r;
          hint = &#34;Find x!&#34;;
        } else if (aOp === &#34;-&#34;) {
          num2 = randomNumber(1, currentAnswer); var r2 = currentAnswer - num2;
          questionText = &#34;x - &#34; + num2 + &#34; = &#34; + r2;
          hint = &#34;Find x!&#34;;
        } else {
          currentAnswer = randomNumber(1, 12 + level); num2 = randomNumber(2, 12);
          var r3 = currentAnswer * num2;
          questionText = &#34;x \u00d7 &#34; + num2 + &#34; = &#34; + r3;
          hint = &#34;Find x!&#34;;
        }
        currentAnswerStr = String(currentAnswer);

      } else if (topic === &#34;fractions&#34;) {
        if (difficulty === &#34;easy&#34;) {
          var denoms = [2, 4];
          var d = denoms[randomNumber(0, denoms.length - 1)];
          var n = randomNumber(1, d - 1);
          var whole = randomNumber(1, 5 + level);
          currentAnswer = parseFloat((whole + n / d).toFixed(2));
          currentAnswerStr = String(currentAnswer);
          questionText = whole + &#34; + &#34; + n + &#34;/&#34; + d + &#34; = ?&#34;;
          hint = &#34;Answer as decimal (e.g. 3.5)&#34;;
        } else if (difficulty === &#34;medium&#34;) {
          var factor = randomNumber(2, 5);
          var sN = randomNumber(1, 6); var sD = randomNumber(sN + 1, 8);
          while (gcd(sN, sD) &gt; 1) { sN = randomNumber(1, 6); sD = randomNumber(sN + 1, 8); }
          questionText = &#34;Simplify: &#34; + (sN * factor) + &#34;/&#34; + (sD * factor);
          currentAnswerStr = sN + &#34;/&#34; + sD; currentAnswer = null;
          hint = &#34;Write as fraction (e.g. 2/3)&#34;;
        } else {
          var d1 = randomNumber(2, 6); var n1 = randomNumber(1, d1 - 1); var n2f = randomNumber(1, d1 - 1);
          var sumN = n1 + n2f;
          questionText = n1 + &#34;/&#34; + d1 + &#34; + &#34; + n2f + &#34;/&#34; + d1 + &#34; = ?&#34;;
          if (sumN &gt;= d1) {
            var wh = Math.floor(sumN / d1); var rem = sumN % d1;
            if (rem === 0) currentAnswerStr = String(wh);
            else { var g = gcd(rem, d1); currentAnswerStr = wh + &#34; &#34; + (rem/g) + &#34;/&#34; + (d1/g); }
          } else { var g2 = gcd(sumN, d1); currentAnswerStr = (sumN/g2) + &#34;/&#34; + (d1/g2); }
          currentAnswer = null;
          hint = &#34;Simplify! (e.g. 1 1/2 or 3/4)&#34;;
        }

      } else if (topic === &#34;squares&#34;) {
        if (difficulty === &#34;hard&#34; &amp;&amp; randomNumber(1,2) === 1) {
          num1 = randomNumber(1, 12 + level);
          var sq = num1 * num1;
          currentAnswer = num1; currentAnswerStr = String(num1);
          questionText = &#34;\u221a&#34; + sq + &#34; = ?&#34;;
          hint = &#34;What \u00d7 itself = &#34; + sq + &#34;?&#34;;
        } else {
          num1 = randomNumber(1, difficulty === &#34;easy&#34; ? 10 + level : difficulty === &#34;medium&#34; ? 15 + level : 20 + level);
          currentAnswer = num1 * num1; currentAnswerStr = String(currentAnswer);
          questionText = num1 + &#34;\u00b2 = ?&#34;;
          hint = num1 + &#34; \u00d7 &#34; + num1;
        }

      } else if (topic === &#34;percentage&#34;) {
        if (difficulty === &#34;easy&#34;) {
          var pcts = [10,25,50]; var p = pcts[randomNumber(0, pcts.length - 1)];
          num1 = randomNumber(2, 10 + level) * 10;
          currentAnswer = (p / 100) * num1; currentAnswerStr = String(currentAnswer);
          questionText = p + &#34;% of &#34; + num1 + &#34; = ?&#34;;
        } else if (difficulty === &#34;medium&#34;) {
          var pcts2 = [10,20,25,50,75]; var p2 = pcts2[randomNumber(0, pcts2.length - 1)];
          num1 = randomNumber(2, 10 + level) * 20;
          currentAnswer = (p2 / 100) * num1; currentAnswerStr = String(currentAnswer);
          questionText = p2 + &#34;% of &#34; + num1 + &#34; = ?&#34;;
        } else {
          var p3 = randomNumber(1, 9) * 10 + randomNumber(0, 1) * 5;
          num1 = randomNumber(2, 10 + level) * 20;
          currentAnswer = parseFloat(((p3 / 100) * num1).toFixed(1)); currentAnswerStr = String(currentAnswer);
          questionText = p3 + &#34;% of &#34; + num1 + &#34; = ?&#34;;
        }
      }

      document.getElementById(&#34;questionDisplay&#34;).textContent = questionText;
      if (hint) document.getElementById(&#34;hintText&#34;).textContent = hint;
    }

    // =====================
    // CHECK ANSWER
    // =====================
    function checkAnswer() {
      if (waiting) return;
      var guessRaw = document.getElementById(&#34;answerInput&#34;).value.trim();
      if (guessRaw === &#34;&#34;) {
        document.getElementById(&#34;feedback&#34;).textContent = &#34;Type an answer first!&#34;;
        document.getElementById(&#34;feedback&#34;).style.color = &#34;#f38ba8&#34;;
        return;
      }

      var isCorrect = false;
      if (currentAnswer === null) {
        isCorrect = guessRaw.replace(/\s+/g, &#34; &#34;).trim() === currentAnswerStr.replace(/\s+/g, &#34; &#34;).trim();
      } else {
        isCorrect = parseFloat(guessRaw) === currentAnswer;
      }

      if (isCorrect) {
        correctCount++; streak++;
        if (streak &gt; bestStreak) bestStreak = streak;

        var points = 10;
        if (streak &gt;= 5) { points = 30; }
        else if (streak &gt;= 3) { points = 20; }

        if (streak &gt; 0 &amp;&amp; streak % 10 === 0) {
          timeLeft += 5;
          document.getElementById(&#34;timerDisplay&#34;).innerHTML = &#34;\u23f1 &#34; + timeLeft + &#34;s&#34;;
          showBonus(&#34;+&#34; + points + &#34; x10 STREAK! +5s!&#34;);
          soundStreak();
        } else if (streak &gt;= 5) { showBonus(&#34;+30 SUPER!&#34;); soundStreak(); }
        else if (streak &gt;= 3) { showBonus(&#34;+20 STREAK!&#34;); soundStreak(); }
        else { soundCorrect(); }

        score += points;

        // XP system
        var xpGain = points;
        xp += xpGain;
        checkLevelUp();

        updateScore(); updateStreak(); updateLevel();

        document.getElementById(&#34;feedback&#34;).innerHTML = &#34;&amp;#127881; Correct! +&#34; + points + &#34; pts!&#34;;
        document.getElementById(&#34;feedback&#34;).style.color = &#34;#a6e3a1&#34;;
        document.getElementById(&#34;questionDisplay&#34;).classList.add(&#34;pop&#34;);
        waiting = true;
        setTimeout(function () {
          document.getElementById(&#34;questionDisplay&#34;).classList.remove(&#34;pop&#34;);
          newQuestion();
        }, 800);

      } else {
        wrongCount++; streak = 0; lives--;
        soundWrong();
        updateLives(); updateStreak();

        var disp = currentAnswer !== null ? currentAnswer : currentAnswerStr;
        document.getElementById(&#34;feedback&#34;).innerHTML = &#34;&amp;#128533; Wrong! Answer: &#34; + disp;
        document.getElementById(&#34;feedback&#34;).style.color = &#34;#f38ba8&#34;;
        document.getElementById(&#34;questionDisplay&#34;).classList.add(&#34;shake&#34;);
        setTimeout(function () { document.getElementById(&#34;questionDisplay&#34;).classList.remove(&#34;shake&#34;); }, 400);

        waiting = true;
        if (lives &lt;= 0) { setTimeout(function () { endGame(); }, 1000); }
        else { setTimeout(function () { newQuestion(); }, 1500); }
      }
    }

    // =====================
    // LEVEL SYSTEM
    // =====================
    function checkLevelUp() {
      while (xp &gt;= xpForNext) {
        xp -= xpForNext;
        level++;
        xpForNext = getXpNeeded(level);
        showLevelUpOverlay();
        soundLevelUp();
      }
    }

    function showLevelUpOverlay() {
      var overlay = document.getElementById(&#34;levelUpOverlay&#34;);
      document.getElementById(&#34;levelUpText&#34;).textContent = &#34;LEVEL UP!&#34;;
      var messages = [
        &#34;&#34;,
        &#34;Bigger numbers incoming!&#34;,
        &#34;Getting tougher!&#34;,
        &#34;You&#39;re on fire!&#34;,
        &#34;Math master mode!&#34;,
        &#34;Legendary difficulty!&#34;,
        &#34;Are you a calculator?!&#34;,
        &#34;Unstoppable!&#34;,
        &#34;Beyond genius!&#34;,
        &#34;MAX POWER!&#34;
      ];
      var msg = messages[Math.min(level - 1, messages.length - 1)] || &#34;Incredible!&#34;;
      document.getElementById(&#34;levelUpSub&#34;).textContent = &#34;Level &#34; + level + &#34; \u{1F31F} &#34; + msg;
      overlay.classList.add(&#34;show&#34;);
      setTimeout(function () { overlay.classList.remove(&#34;show&#34;); }, 1800);
    }

    function updateLevel() {
      document.getElementById(&#34;levelDisplay&#34;).innerHTML = &#34;&amp;#11088; Lv. &#34; + level;
      var pct = Math.min((xp / xpForNext) * 100, 100);
      document.getElementById(&#34;xpFill&#34;).style.width = pct + &#34;%&#34;;
      document.getElementById(&#34;xpText&#34;).textContent = xp + &#34; / &#34; + xpForNext + &#34; XP&#34;;
    }

    // =====================
    // SKIP
    // =====================
    function skipQuestion() {
      if (waiting) return;
      skippedCount++; streak = 0; updateStreak(); waiting = true;
      soundSkip();
      var disp = currentAnswer !== null ? currentAnswer : currentAnswerStr;
      document.getElementById(&#34;feedback&#34;).innerHTML = &#34;&amp;#9193; Skipped! Answer: &#34; + disp;
      document.getElementById(&#34;feedback&#34;).style.color = &#34;#89dceb&#34;;
      setTimeout(function () { newQuestion(); }, 1000);
    }

    // =====================
    // UPDATES
    // =====================
    function updateScore() {
      document.getElementById(&#34;scoreDisplay&#34;).textContent = &#34;Score: &#34; + score;
      document.getElementById(&#34;scoreDisplay&#34;).classList.add(&#34;pop&#34;);
      setTimeout(function () { document.getElementById(&#34;scoreDisplay&#34;).classList.remove(&#34;pop&#34;); }, 400);
    }

    function updateLives() {
      var h = &#34;&#34;;
      for (var i = 0; i &lt; lives; i++) h += &#34;&amp;#10084;&#34;;
      for (var j = lives; j &lt; 3; j++) h += &#34;&amp;#128420;&#34;;
      document.getElementById(&#34;livesDisplay&#34;).innerHTML = h;
    }

    function updateStreak() {
      document.getElementById(&#34;streakText&#34;).innerHTML = &#34;&amp;#128293; Streak: &#34; + streak;
      document.getElementById(&#34;streakFill&#34;).style.width = Math.min(streak * 20, 100) + &#34;%&#34;;
    }

    function showBonus(text) {
      var el = document.createElement(&#34;div&#34;);
      el.className = &#34;bonus-float&#34;; el.textContent = text;
      el.style.left = &#34;50%&#34;; el.style.top = &#34;40%&#34;;
      document.body.appendChild(el);
      setTimeout(function () { el.remove(); }, 1000);
    }

    // =====================
    // END GAME
    // =====================
    function endGame() {
      clearInterval(timer);
      soundGameOver();
      showScreen(&#34;endScreen&#34;);

      var total = correctCount + wrongCount;
      var pct = total &gt; 0 ? Math.round((correctCount / total) * 100) : 0;

      var grade, emoji, title;
      if (pct &gt;= 90) { grade=&#34;A+&#34;; emoji=&#34;&amp;#129351;&#34;; title=&#34;AMAZING, &#34;+playerName+&#34;!&#34;; }
      else if (pct &gt;= 80) { grade=&#34;A&#34;; emoji=&#34;&amp;#11088;&#34;; title=&#34;GREAT JOB, &#34;+playerName+&#34;!&#34;; }
      else if (pct &gt;= 70) { grade=&#34;B&#34;; emoji=&#34;&amp;#128170;&#34;; title=&#34;GOOD WORK, &#34;+playerName+&#34;!&#34;; }
      else if (pct &gt;= 50) { grade=&#34;C&#34;; emoji=&#34;&amp;#128515;&#34;; title=&#34;NICE TRY, &#34;+playerName+&#34;!&#34;; }
      else { grade=&#34;D&#34;; emoji=&#34;&amp;#128170;&#34;; title=&#34;KEEP PRACTICING, &#34;+playerName+&#34;!&#34;; }

      document.getElementById(&#34;endEmoji&#34;).innerHTML = emoji;
      document.getElementById(&#34;endTitle&#34;).textContent = title;
      document.getElementById(&#34;gradeBox&#34;).innerHTML =
        &#39;&lt;span style=&#34;color:#f9e64f;font-size:65px;&#34;&gt;&#39;+grade+&#39;&lt;/span&gt;&lt;br&gt;&#39; +
        &#39;&lt;span style=&#34;font-size:20px;color:#89dceb;&#34;&gt;&#39;+pct+&#39;% correct&lt;/span&gt;&#39;;

      var tn = {addition:&#34;Addition&#34;,subtraction:&#34;Subtraction&#34;,multiplication:&#34;Multiplication&#34;,
        division:&#34;Division&#34;,mixed:&#34;Mixed&#34;,decimals:&#34;Decimals&#34;,algebra:&#34;Algebra&#34;,
        fractions:&#34;Fractions&#34;,squares:&#34;Squares&#34;,percentage:&#34;Percentage&#34;};

      document.getElementById(&#34;statsBox&#34;).innerHTML =
        &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;&amp;#127918; Score&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39;+score+&#39;&lt;/span&gt;&lt;/div&gt;&#39; +
        &#39;&lt;div class=&#34;stat-row&#34;&gt;&lt;span class=&#34;stat-label&#34;&gt;&amp;#11088; Level Reached&lt;/span&gt;&lt;span class=&#34;stat-value&#34;&gt;&#39;+level+&#39;&lt;/span&gt;&lt;/div&gt;&#39; +
