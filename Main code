    // =====================
    // SCREENS
    // =====================
    function showScreen(id) {
      var screens = [&#34;authScreen&#34;,&#34;startScreen&#34;,&#34;gameScreen&#34;,&#34;endScreen&#34;,&#34;leaderboardScreen&#34;,&#34;howToPlayScreen&#34;,&#34;friendsScreen&#34;,&#34;challengesScreen&#34;,&#34;liveLobbyScreen&#34;,&#34;liveMatchScreen&#34;];
      for (var i = 0; i &lt; screens.length; i++) document.getElementById(screens[i]).classList.remove(&#34;active&#34;);
      document.getElementById(id).classList.add(&#34;active&#34;);
