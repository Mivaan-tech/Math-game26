    <script>
      // =====================
    // FIREBASE RTDB HELPERS
    // =====================
    var FB_URL = &#34;https://craft-combat-default-rtdb.firebaseio.com&#34;;
    var FB_ROOT = &#34;/mathgame&#34;;

    function fbGet(path) {
      return fetch(FB_URL + FB_ROOT + path + &#34;.json&#34;).then(function(r){ return r.json(); });
    }
    function fbPut(path, data) {
      return fetch(FB_URL + FB_ROOT + path + &#34;.json&#34;, {
        method: &#34;PUT&#34;, headers: {&#34;Content-Type&#34;:&#34;application/json&#34;},
        body: JSON.stringify(data)
      }).then(function(r){ return r.json(); });
    }
    function fbPatch(path, data) {
      return fetch(FB_URL + FB_ROOT + path + &#34;.json&#34;, {
        method: &#34;PATCH&#34;, headers: {&#34;Content-Type&#34;:&#34;application/json&#34;},
        body: JSON.stringify(data)
      }).then(function(r){ return r.json(); });
    }
    function fbDelete(path) {
      return fetch(FB_URL + FB_ROOT + path + &#34;.json&#34;, { method: &#34;DELETE&#34; });
    }
    function fbPost(path, data) {
      return fetch(FB_URL + FB_ROOT + path + &#34;.json&#34;, {
        method: &#34;POST&#34;, headers: {&#34;Content-Type&#34;:&#34;application/json&#34;},
        body: JSON.stringify(data)
      }).then(function(r){ return r.json(); });
    }

    // =====================
    // AUTH / SESSION
    // =====================
    var currentUser = null; // username string
    var currentPassHash = null;

    async function sha256(str) {
      var buf = new TextEncoder().encode(str);
      var hash = await crypto.subtle.digest(&#34;SHA-256&#34;, buf);
      var bytes = new Uint8Array(hash);
      var out = &#34;&#34;;
      for (var i = 0; i &lt; bytes.length; i++) out += bytes[i].toString(16).padStart(2, &#34;0&#34;);
      return out;
    }

    function validUsername(u) { return /^[a-zA-Z0-9_]{3,15}$/.test(u); }

    async function doSignup() {
      var u = document.getElementById(&#34;authUsername&#34;).value.trim().toLowerCase();
      var p = document.getElementById(&#34;authPassword&#34;).value;
      var err = document.getElementById(&#34;authError&#34;);
      err.textContent = &#34;&#34;;
      if (!validUsername(u)) { err.textContent = &#34;Username: 3-15 chars, letters/numbers/_ only.&#34;; return; }
      if (p.length &lt; 4) { err.textContent = &#34;Password must be at least 4 characters.&#34;; return; }

      var existing = await fbGet(&#34;/users/&#34; + u);
      if (existing) { err.textContent = &#34;Username already taken!&#34;; return; }

      var hash = await sha256(p);
      await fbPut(&#34;/users/&#34; + u, { passHash: hash, createdAt: Date.now() });
      localStorage.setItem(&#34;mathGameSession&#34;, JSON.stringify({ u: u, h: hash }));
      currentUser = u; currentPassHash = hash;
      enterApp();
    }

    async function doLogin() {
      var u = document.getElementById(&#34;authUsername&#34;).value.trim().toLowerCase();
      var p = document.getElementById(&#34;authPassword&#34;).value;
      var err = document.getElementById(&#34;authError&#34;);
      err.textContent = &#34;&#34;;
      if (!u || !p) { err.textContent = &#34;Enter username and password.&#34;; return; }

      var rec = await fbGet(&#34;/users/&#34; + u);
      if (!rec) { err.textContent = &#34;No account with that username.&#34;; return; }
      var hash = await sha256(p);
      if (rec.passHash !== hash) { err.textContent = &#34;Wrong password.&#34;; return; }

      localStorage.setItem(&#34;mathGameSession&#34;, JSON.stringify({ u: u, h: hash }));
      currentUser = u; currentPassHash = hash;
      enterApp();
    }

    function doLogout() {
      stopInboxPoll();
      localStorage.removeItem(&#34;mathGameSession&#34;);
      currentUser = null; currentPassHash = null;
      document.getElementById(&#34;authUsername&#34;).value = &#34;&#34;;
      document.getElementById(&#34;authPassword&#34;).value = &#34;&#34;;
      showScreen(&#34;authScreen&#34;);
    }

    async function tryRestoreSession() {
      var raw = localStorage.getItem(&#34;mathGameSession&#34;);
      if (!raw) return false;
      try {
        var s = JSON.parse(raw);
        var rec = await fbGet(&#34;/users/&#34; + s.u);
        if (rec &amp;&amp; rec.passHash === s.h) {
          currentUser = s.u; currentPassHash = s.h;
          return true;
        }
      } catch (e) {}
      localStorage.removeItem(&#34;mathGameSession&#34;);
      return false;
    }

    function enterApp() {
      document.getElementById(&#34;loggedInName&#34;).textContent = currentUser;
      showScreen(&#34;startScreen&#34;);
      refreshInbox();
      startInboxPoll();
    }

    // =====================
    // SOUND SYSTEM
    // =====================
    var soundOn = true;
    var audioCtx = null;

    function getAudioCtx() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      return audioCtx;
    }

    function playTone(freq, duration, type, volume) {
      if (!soundOn) return;
      try {
        var ctx = getAudioCtx();
        var osc = ctx.createOscillator();
        var gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.type = type || &#34;sine&#34;;
        osc.frequency.value = freq;
        gain.gain.value = volume || 0.3;
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    }

    function soundCorrect() {
      playTone(523, 0.1, &#34;sine&#34;, 0.3);
      setTimeout(function() { playTone(659, 0.1, &#34;sine&#34;, 0.3); }, 100);
      setTimeout(function() { playTone(784, 0.15, &#34;sine&#34;, 0.3); }, 200);
    }

    function soundWrong() {
      playTone(200, 0.15, &#34;square&#34;, 0.2);
      setTimeout(function() { playTone(150, 0.3, &#34;square&#34;, 0.2); }, 150);
    }

    function soundClick() {
      playTone(800, 0.05, &#34;sine&#34;, 0.15);
    }

    function soundSkip() {
      playTone(400, 0.1, &#34;triangle&#34;, 0.2);
      setTimeout(function() { playTone(300, 0.1, &#34;triangle&#34;, 0.2); }, 100);
    }

    function soundLevelUp() {
      playTone(523, 0.12, &#34;sine&#34;, 0.3);
      setTimeout(function() { playTone(659, 0.12, &#34;sine&#34;, 0.3); }, 120);
      setTimeout(function() { playTone(784, 0.12, &#34;sine&#34;, 0.3); }, 240);
      setTimeout(function() { playTone(1047, 0.3, &#34;sine&#34;, 0.35); }, 360);
    }

    function soundGameOver() {
      playTone(400, 0.2, &#34;sine&#34;, 0.3);
      setTimeout(function() { playTone(350, 0.2, &#34;sine&#34;, 0.3); }, 200);
      setTimeout(function() { playTone(300, 0.2, &#34;sine&#34;, 0.3); }, 400);
      setTimeout(function() { playTone(200, 0.5, &#34;sine&#34;, 0.25); }, 600);
    }

    function soundStreak() {
      playTone(600, 0.08, &#34;sine&#34;, 0.25);
      setTimeout(function() { playTone(800, 0.08, &#34;sine&#34;, 0.25); }, 80);
      setTimeout(function() { playTone(1000, 0.15, &#34;sine&#34;, 0.3); }, 160);
    }

    function soundTick() {
      playTone(1000, 0.03, &#34;sine&#34;, 0.1);
    }

    function soundStart() {
      playTone(400, 0.1, &#34;sine&#34;, 0.25);
      setTimeout(function() { playTone(500, 0.1, &#34;sine&#34;, 0.25); }, 100);
      setTimeout(function() { playTone(600, 0.1, &#34;sine&#34;, 0.25); }, 200);
      setTimeout(function() { playTone(800, 0.2, &#34;sine&#34;, 0.3); }, 300);
    }

    function toggleSound() {
      soundOn = !soundOn;
      document.getElementById(&#34;soundToggle&#34;).textContent = soundOn ? &#34;\u{1F50A}&#34; : &#34;\u{1F507}&#34;;
      if (soundOn) soundClick();
    }

    // =====================
    // GAME VARIABLES
    // =====================
    var playerName = &#34;&#34;;
    var difficulty = &#34;&#34;;
    var topic = &#34;&#34;;
    var score = 0;
    var lives = 3;
    var currentAnswer = 0;
    var currentAnswerStr = &#34;&#34;;
    var questionCount = 0;
    var correctCount = 0;
    var wrongCount = 0;
    var skippedCount = 0;
    var streak = 0;
    var bestStreak = 0;
    var timeLeft = 60;
    var timer = null;
    var lbFilter = &#34;all&#34;;

    // LEVEL SYSTEM
    var level = 1;
    var xp = 0;
    var xpForNext = 50;

    // ANTI-SPAM
    var waiting = false;

    function getXpNeeded(lvl) {
      // 50, 80, 120, 170, 230, 300...
      return 50 + (lvl - 1) * 30 + Math.floor((lvl - 1) * (lvl - 1) * 5);
    }

    // =====================
    // TOPIC &amp; DIFFICULTY
    // =====================
    function pickTopic(t, btn) {
