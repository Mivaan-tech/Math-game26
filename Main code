    async function refreshInbox() {
      if (!currentUser) return;
      try {
        var rec = await fbGet(&#34;/users/&#34; + currentUser);
        if (!rec) return;
        var reqs = rec.friendRequests || {};
        var chs = rec.challenges || {};
        var reqCount = Object.keys(reqs).length;
        var chCount = 0;
        for (var k in chs) { if (chs[k].status === &#34;pending&#34;) chCount++; }

        var reqBadge = document.getElementById(&#34;reqBadge&#34;);
        reqBadge.textContent = reqCount;
        reqBadge.style.display = reqCount &gt; 0 ? &#34;inline-block&#34; : &#34;none&#34;;

        var incBadge = document.getElementById(&#34;incBadge&#34;);
        incBadge.textContent = chCount;
        incBadge.style.display = chCount &gt; 0 ? &#34;inline-block&#34; : &#34;none&#34;;

        var inbox = document.getElementById(&#34;inboxBadge&#34;);
        var total = reqCount + chCount;
        inbox.textContent = total;
        inbox.style.display = total &gt; 0 ? &#34;inline-block&#34; : &#34;none&#34;;
      } catch (e) {}
    }

