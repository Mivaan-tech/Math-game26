      var rec = await fbGet(&#34;/asyncChallenges/&#34; + id);
      if (rec &amp;&amp; rec.fromScore != null &amp;&amp; rec.toScore != null) {
        var winner = rec.fromScore === rec.toScore ? &#34;tie&#34; : (rec.fromScore &gt; rec.toScore ? rec.from : rec.to);
        var summaryA = { opponent: rec.to, topic: rec.topic, difficulty: rec.difficulty,
          myScore: rec.fromScore, theirScore: rec.toScore, winner: winner, when: Date.now() };
        var summaryB = { opponent: rec.from, topic: rec.topic, difficulty: rec.difficulty,
